{
  "name": "atlas-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && pnpm platform:build && node scripts/copy-platform-web.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*model.test.mjs tests/city-traffic.test.mjs tests/city-construction.test.mjs tests/city-people.test.mjs tests/city-communications.test.mjs tests/city-architecture.test.mjs tests/city-industry-visual.test.mjs tests/city-celebrations.test.mjs tests/city-assistant-panel.test.mjs",
    "test:e2e": "node tests/city-browser.mjs",
    "test:city-v2": "node tests/city-v2-browser.mjs",
    "test:city-v3": "node tests/city-v3-browser.mjs",
    "test:city-v4": "node tests/city-v4-browser.mjs",
    "test:city-v5": "node tests/city-v5-browser.mjs",
    "test:demo": "node tests/demo-simulation-browser.mjs",
    "test:demo:live": "node tests/demo-browser.mjs",
    "test:luma": "node tests/luma-browser.mjs",
    "test:classic": "node tests/smoke.mjs",
    "test:operations": "node tests/operations-browser.mjs",
    "platform:build": "pnpm --filter @birdview/web build",
    "platform:types": "tsc -p tsconfig.platform.json",
    "platform:dev": "node --env-file=.env --import tsx scripts/dev-platform.ts",
    "platform:api": "node --env-file=.env --import tsx apps/api/src/server.ts",
    "platform:worker": "node --env-file=.env --import tsx apps/worker/src/index.ts",
    "platform:migrate": "node --env-file=.env --import tsx packages/db/src/migrate.ts",
    "platform:seed": "node --env-file=.env --import tsx packages/fixtures/src/seed.ts",
    "platform:test": "node --env-file=.local/test.env node_modules/vitest/vitest.mjs run --config vitest.platform.config.ts",
    "platform:e2e": "node --env-file=.env --import tsx tests/platform/e2e.ts",
    "platform:test:prepare": "node --env-file=.env --import tsx scripts/prepare-test-db.ts",
    "platform:lint": "node scripts/check-platform-source.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@tavus/embed": "0.19.3",
    "@tavus/widget": "0.19.3",
    "ajv": "8.20.0",
    "lucide": "0.468.0",
    "three": "0.180.0",
    "@tanstack/react-query": "5.105.1",
    "@radix-ui/react-dialog": "1.3.1",
    "react-router-dom": "7.18.5",
    "react-dom": "19.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "recharts": "3.10.1",
    "lucide-react": "1.66.0",
    "@fontsource/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@fastify/swagger": "9.5.2",
    "@fastify/rate-limit": "10.3.0",
    "ioredis": "5.8.2",
    "pg": "8.23.1",
    "bullmq": "5.63.0",
    "drizzle-orm": "0.45.4",
    "tsx": "4.23.15",
    "@aws-sdk/client-s3": "3.1161.0",
    "react": "19.3.1",
    "zod": "4.6.7",
    "fastify": "5.12.8",
    "better-auth": "1.7.15",
    "@birdview/contracts": "workspace:*",
    "@birdview/db": "workspace:*",
    "@birdview/auth": "workspace:*",
    "@birdview/authz": "workspace:*",
    "@birdview/analytics": "workspace:*",
    "@birdview/privacy": "workspace:*",
    "@birdview/ai": "workspace:*",
    "@birdview/connectors": "workspace:*",
    "@birdview/reporting": "workspace:*",
    "@birdview/jobs": "workspace:*",
    "@birdview/city": "workspace:*",
    "@birdview/fixtures": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "typescript": "5.9.3",
    "@types/pg": "8.23.1",
    "@types/react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/node": "24.10.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  }
}
