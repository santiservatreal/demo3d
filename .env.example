# Bootstrap replaces the empty secrets with random local values. Never commit .env.
APP_PROFILE=demo
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5174
API_PORT=3001
POSTGRES_DB=birdview
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
AUTH_DB_PASSWORD=
VAULT_DB_PASSWORD=
REDIS_PASSWORD=
MIGRATION_DATABASE_URL=
DATABASE_URL=
AUTH_DATABASE_URL=
VAULT_DATABASE_URL=
REDIS_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001
CSRF_SECRET=
VAULT_ENCRYPTION_KEY=
VAULT_LOOKUP_KEY=
VAULT_KEY_VERSION=v1
ARTIFACT_DIR=.local/artifacts
CHROMIUM_PATH=/usr/bin/chromium
# Operator-managed exact HTTPS URLs; no provider is required for demo.
AI_ALLOWED_ENDPOINTS=
AI_PROVIDER_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Docker-only origin/profile. Production requires APP_PROFILE=production and BIRDVIEW_NODE_ENV=production.
PUBLIC_ORIGIN=http://127.0.0.1:8080
BIRDVIEW_NODE_ENV=development
# Optional vault rotation: retain older versions until scopes and backups expire.
VAULT_KEYS_JSON=
# Vercel bridge only: public HTTPS origin of the separately hosted BirdView API.
# This is not a database URL. Leave empty for the direct Docker installation.
BIRDVIEW_API_ORIGIN=
# Frontend build: 1 forces browser tests; 0 forces real server mode.
# Unset: Vercel without BIRDVIEW_API_ORIGIN uses the free browser demo automatically.
BIRDVIEW_BROWSER_DEMO=
