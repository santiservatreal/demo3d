# Vercel server variables (GET /api/tavus-config returns public configuration):
TAVUS_DEPLOYMENT_ID=
TAVUS_PAL_ID=p5695fb057e5
# Exported schemas and explicit bindings; see docs/demo/TOOL_CONTRACTS.md.
TAVUS_TOOL_CONTRACTS_JSON=
# No TAVUS_API_KEY is needed or exposed by this deployment integration.
